{
    "$comment": "Manifeste des applications surveillées par iA_Update. Champs par application : id, name, category, homepage, detect (cmd/paths par OS), versionLocal.regex, online (source de version en ligne), downloadUrl, updateCommand (par OS). Les types online supportés : github (repo), npm (package), pypi (package), endoflife (key), none (pas de source fiable).",
    "apps": [
        {
            "id": "python",
            "name": "Python",
            "category": "Runtime",
            "homepage": "https://www.python.org/",
            "scope_default": "global",
            "detect": {
                "windows": { "cmd": ["py", "--version"], "paths": ["C:/Python*", "C:/Program Files/Python*"] },
                "linux": { "cmd": ["python3", "--version"], "paths": ["/usr/bin/python3", "/usr/local/bin/python3"] }
            },
            "versionLocal": { "regex": "(\\d+\\.\\d+\\.\\d+)" },
            "online": { "type": "endoflife", "key": "python" },
            "downloadUrl": "https://www.python.org/downloads/",
            "updateCommand": {
                "windows": "winget upgrade --id Python.Python.3.12",
                "linux": "sudo apt update && sudo apt upgrade python3"
            }
        },
        {
            "id": "nodejs",
            "name": "Node.js",
            "category": "Runtime",
            "homepage": "https://nodejs.org/",
            "scope_default": "global",
            "detect": {
                "windows": { "cmd": ["node", "--version"] },
                "linux": { "cmd": ["node", "--version"] }
            },
            "versionLocal": { "regex": "v?(\\d+\\.\\d+\\.\\d+)" },
            "online": { "type": "endoflife", "key": "nodejs" },
            "downloadUrl": "https://nodejs.org/en/download",
            "updateCommand": {
                "windows": "winget upgrade --id OpenJS.NodeJS.LTS",
                "linux": "sudo apt update && sudo apt upgrade nodejs"
            }
        },
        {
            "id": "ghostwriter",
            "name": "Ghostwriter",
            "category": "Editeur",
            "homepage": "https://ghostwriter.kde.org/",
            "scope_default": "global",
            "detect": {
                "windows": { "cmd": [], "paths": ["C:/Program Files/Ghostwriter/ghostwriter.exe"] },
                "linux": { "cmd": ["ghostwriter"] }
            },
            "versionLocal": { "regex": "" },
            "online": { "type": "github", "repo": "wereturtle/ghostwriter" },
            "downloadUrl": "https://github.com/wereturtle/ghostwriter/releases",
            "updateCommand": {
                "windows": "winget upgrade --id Ghostwriter.Ghostwriter",
                "linux": "sudo apt update && sudo apt upgrade ghostwriter"
            }
        },
        {
            "id": "nodered",
            "name": "Node-RED",
            "category": "Automation",
            "homepage": "https://nodered.org/",
            "scope_default": "global",
            "detect": {
                "windows": { "cmd": ["node-red", "--version"] },
                "linux": { "cmd": ["node-red", "--version"] }
            },
            "versionLocal": { "regex": "(\\d+\\.\\d+\\.\\d+)" },
            "online": { "type": "npm", "package": "node-red" },
            "downloadUrl": "https://www.npmjs.com/package/node-red",
            "updateCommand": {
                "windows": "npm install -g node-red",
                "linux": "sudo npm install -g --unsafe-perm node-red"
            }
        },
        {
            "id": "n8n",
