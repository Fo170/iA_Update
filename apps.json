{
    "$comment": "Manifeste des applications surveillées par iA_Update. Champs : id, name, category (outils/local/assistants/code), homepage, detect (cmd/locate/paths par OS), versionLocal (regex/registry/fromPath), online (github/npm/pypi/endoflife/none), downloadUrl, updateCommand (par OS), repairCommand (par OS).",
    "apps": [
        {
            "id": "python",
            "name": "Python",
            "category": "outils",
            "homepage": "https://www.python.org/",
            "scope_default": "global",
            "detect": {
                "windows": { "cmd": ["py", "--version"], "paths": ["C:/Python*", "C:/Program Files/Python*", "%LOCALAPPDATA%/Programs/Python/Python*/python.exe"] },
                "linux": { "cmd": ["python3", "--version"], "paths": ["/usr/bin/python3", "/usr/local/bin/python3"] }
            },
            "versionLocal": { "regex": "(\\d+\\.\\d+\\.\\d+)" },
            "online": { "type": "endoflife", "key": "python" },
            "downloadUrl": "https://www.python.org/downloads/",
            "updateCommand": {
                "windows": "winget upgrade --id Python.Python.3.12",
                "linux": "sudo apt update && sudo apt upgrade python3"
            },
            "repairCommand": {
                "windows": "winget install --id Python.Python.3.12 --force",
                "linux": "sudo apt update && sudo apt install --reinstall python3"
            }
        },
        {
            "id": "nodejs",
            "name": "Node.js",
            "category": "outils",
            "homepage": "https://nodejs.org/",
            "scope_default": "global",
            "detect": {
                "windows": { "cmd": ["node", "--version"] },
                "linux": { "cmd": ["node", "--version"] }
            },
            "versionLocal": { "regex": "v?(\\d+\\.\\d+\\.\\d+)" },
            "online": { "type": "endoflife", "key": "nodejs" },
            "downloadUrl": "https://nodejs.org/en/download",
            "updateCommand": {
                "windows": "winget upgrade --id OpenJS.NodeJS.LTS",
                "linux": "sudo apt update && sudo apt upgrade nodejs"
            },
            "repairCommand": {
                "windows": "winget install --id OpenJS.NodeJS.LTS --force",
                "linux": "sudo apt update && sudo apt install --reinstall nodejs"
            }
        },
