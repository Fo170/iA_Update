            "online": { "type": "endoflife", "key": "qt" },
            "downloadUrl": "https://www.qt.io/download",
            "updateCommand": {
                "windows": "winget upgrade --id QtProject.Qt",
                "linux": "sudo apt update && sudo apt upgrade qt6-base-dev"
